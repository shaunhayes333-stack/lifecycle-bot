<?xml version="1.0" encoding="utf-8"?>
<!--
  V5.0.7028 — the render's list row.

  Watchlist, Insiders, Positions and Universe all use the same row surface:
  `linear-gradient(150deg, rgba(20,31,60,.86), rgba(9,14,30,.93))`, 14px
  radius, 1px rgba(124,196,255,.18). It is a step lighter than the page and a
  step darker than a card, which is what puts a list BETWEEN the ground and
  the hero rather than level with either.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:type="linear" android:angle="300"
        android:startColor="#DB141F3C" android:endColor="#ED090E1E"/>
    <stroke android:width="1dp" android:color="#2E7CC4FF"/>
    <corners android:radius="14dp"/>
</shape>
