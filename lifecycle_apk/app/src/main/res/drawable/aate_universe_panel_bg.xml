<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135"
                android:startColor="#E60D1A2E" android:centerColor="#E6091424" android:endColor="#EE050C18"/>
            <stroke android:width="1dp" android:color="#385A86B8"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="190dp"
                android:centerX="0.08" android:centerY="0.00"
                android:startColor="#184C8DFF" android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#004C8DFF" android:centerColor="#AA4C8DFF" android:endColor="#0031C7FF"/>
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"/>
        </shape>
    </item>
</layer-list>
