<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135"
                android:startColor="#24325A" android:centerColor="#182643" android:endColor="#0C1728"/>
            <stroke android:width="1dp" android:color="#8A9A4DFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135"
                android:startColor="#D9122139" android:centerColor="#E60B1729" android:endColor="#EB07101D"/>
            <stroke android:width="1dp" android:color="#3851759E"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
