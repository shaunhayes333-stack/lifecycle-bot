<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#CC121C32" android:centerColor="#CC10182B" android:endColor="#CC091322"/>
            <stroke android:width="1dp" android:color="#5A6EA4FF"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#009A4DFF" android:centerColor="#AA9A4DFF" android:endColor="#0031C7FF"/>
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp"/>
        </shape>
    </item>
</layer-list>
