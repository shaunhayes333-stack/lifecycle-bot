<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7B2FE0" android:endColor="#8A45EA"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7F35E6" android:centerColor="#9A4DFF" android:endColor="#6E4CFF"/>
            <stroke android:width="1dp" android:color="#B36BFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
