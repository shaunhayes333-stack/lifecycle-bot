<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#E6112038" android:centerColor="#EA0A1628" android:endColor="#F0060E1A"/>
            <stroke android:width="1dp" android:color="#3B5E8A"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:width="3dp" android:gravity="left">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#0031C7FF" android:centerColor="#AA9A4DFF" android:endColor="#0016E6A1"/>
            <corners android:topLeftRadius="18dp" android:bottomLeftRadius="18dp"/>
        </shape>
    </item>
</layer-list>
