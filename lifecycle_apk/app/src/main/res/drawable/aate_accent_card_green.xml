<?xml version="1.0" encoding="utf-8"?>
<!--
  V5.0.7020 — accent card, #34D399.

  From project/Markets.dc.html, where EVERY element carries its own colour:
  the engine pills are purple / cyan / amber, the asset rows each take their
  class's hue, the portfolio card is green and the learning card purple.

  The app had one blue-grey card for all of it. Uniformity is the opposite of
  hierarchy — when every surface is the same object, the screen reads as a list
  of boxes, which is exactly what the operator kept seeing.

  Recipe, matched to the render and not invented:
    fill   linear-gradient(150deg, rgba(accent,.14), rgba(9,14,30,.94))
    border 1px solid rgba(accent,.30)
  One hairline. No 3dp/2dp concentric glow rings.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:type="linear" android:angle="300"
        android:startColor="#2434D399" android:endColor="#F0090E1E"/>
    <stroke android:width="1dp" android:color="#4D34D399"/>
    <corners android:radius="15dp"/>
</shape>
