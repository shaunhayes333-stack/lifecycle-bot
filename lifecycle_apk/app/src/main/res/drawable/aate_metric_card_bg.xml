<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135"
                android:startColor="#E6112038" android:centerColor="#EA0A1628" android:endColor="#F0060E1A"/>
            <stroke android:width="1dp" android:color="#3D5D8B"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="120dp"
                android:centerX="0.10" android:centerY="0.00"
                android:startColor="#144C8DFF" android:endColor="#00000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#004C8DFF" android:centerColor="#884C8DFF" android:endColor="#0031C7FF"/>
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"/>
        </shape>
    </item>
</layer-list>
