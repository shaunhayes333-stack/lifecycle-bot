<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#773B1B8D" android:centerColor="#AA6D28D9" android:endColor="#779A4DFF"/>
            <stroke android:width="1dp" android:color="#B39A4DFF"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#CCB36BFF"/>
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp"/>
        </shape>
    </item>
</layer-list>
