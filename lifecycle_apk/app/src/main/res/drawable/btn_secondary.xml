<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#253555"/>
            <stroke android:width="1dp" android:color="#6F86B7"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#D9102038" android:endColor="#E9081424"/>
            <stroke android:width="1dp" android:color="#2B4B78"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
