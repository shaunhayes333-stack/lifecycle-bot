<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B30A1424"/>
            <stroke android:width="1dp" android:color="#375A86"/>
            <corners android:radius="14dp"/>
            <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"/>
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#004C8DFF" android:centerColor="#664C8DFF" android:endColor="#0031C7FF"/>
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"/>
        </shape>
    </item>
</layer-list>
