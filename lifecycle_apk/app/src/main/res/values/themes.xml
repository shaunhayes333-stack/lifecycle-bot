<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AATE vNext is intentionally dark in both system modes so every trading surface
         has one coherent visual language. This file changes presentation only. -->
    <style name="Theme.AATE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/aate_purple</item>
        <item name="colorPrimaryVariant">@color/aate_purple_bright</item>
        <item name="colorOnPrimary">@color/aate_text</item>
        <item name="colorSecondary">@color/aate_cyan</item>
        <item name="colorOnSecondary">@color/aate_bg</item>
        <item name="colorSurface">@color/aate_surface</item>
        <item name="colorOnSurface">@color/aate_text</item>
        <item name="android:colorBackground">@color/aate_bg</item>
        <item name="colorOnBackground">@color/aate_text</item>
        <item name="android:windowBackground">@drawable/aate_screen_bg</item>
        <item name="android:colorAccent">@color/aate_purple</item>
        <item name="android:textColorPrimary">@color/aate_text</item>
        <item name="android:textColorSecondary">@color/aate_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/aate_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!--
             V5.0.7008 §THE_WHOLE_APP_WAS_SET_IN_MONOSPACE.
             This one line made every label, heading, button and paragraph in
             all 21 screens draw in a fixed-pitch face, which is the single
             biggest reason the app read as a terminal dump instead of a
             product. Monospace earns its place on NUMBERS (they line up
             column to column) and nowhere else, so it moves to @style/T.Mono
             and the default becomes the render's body face.
        -->
        <item name="android:fontFamily">@font/aate_body</item>
        <item name="fontFamily">@font/aate_body</item>
        <item name="android:textAppearance">@style/T.Body</item>
        <item name="materialButtonStyle">@style/BtnPrimary</item>
    </style>

    <style name="Theme.AATE.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@drawable/aate_screen_bg</item>
        <item name="android:statusBarColor">@color/aate_bg_deep</item>
        <item name="android:navigationBarColor">@color/aate_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_universe_panel_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="CardLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="KpiLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="KpiValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_vnext_input_bg</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textColorHint">@color/aate_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/aate_vnext_input_bg</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="BtnPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/aate_purple</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="rippleColor">@color/aate_purple_bright</item>
    </style>

    <style name="BtnSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/aate_text</item>
        <item name="strokeColor">@color/aate_stroke</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:backgroundTint">@color/aate_surface</item>
    </style>

    <style name="Theme.AATE.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/aate_surface</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textColorPrimary">@color/aate_text</item>
        <item name="android:textColorSecondary">@color/aate_text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/aate_green</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════
         V5.0.6933 — AATE vNext type + component library.
         Derived from the operator's reference renders. Presentation only.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── TYPE SCALE ─────────────────────────────────────────────────── -->

    <!--
      Screen title: "Watchlist", "Insider Wallets", "Trade Journal".

      V5.0.7028 §THE_HEADER_WAS_WRONG_ON_ALL_TWENTY_ONE_SCREENS.

      This style was 19sp MONOSPACE, ALL CAPS, letterSpacing .10 — so every
      screen in the app opened with "TRADE JOURNAL" spaced out in a terminal
      face. Not one artboard does that. The render's titles are 18px Space
      Grotesk, bold, SENTENCE CASE, no tracking, and it is the uppercase
      LETTERSPACED line UNDERNEATH that carries the terminal character.

      That inversion is most of why the operator kept saying the screens were
      "not close": the first thing the eye lands on, on every screen, was set
      in the wrong case, the wrong face and the wrong rhythm. Fixing it here
      fixes all twenty-one at once, because every one of them uses this style
      — which is also why nobody caught it: it was never wrong on ONE screen.

      sans-serif-medium, not monospace: Space Grotesk is not bundled, and of
      the system faces it is the geometric sans that sits closest. The mono
      face is kept for NUMBERS, where it belongs and where the render also
      uses it (JetBrains Mono on every figure).
    -->
    <style name="AateScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      Sub-title under a screen title: "DISCOVER · TRACK · PROMOTE".

      V5.0.7028 — now the uppercase tracked line the render actually uses
      (10px, #7E93BC, letter-spacing .05), and the place the terminal voice
      moved to when the title above it stopped shouting.
    -->
    <style name="AateScreenSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#7E93BC</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!--
      V5.0.7028 — one PIN keypad key. project/Security.dc.html: 62px tall,
      21px radius, Space Grotesk 600 at 22px. Declared here rather than
      repeated twelve times in the layout.
    -->
    <style name="AateKeypadKey">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/aate_keypad_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Card/section heading: "COLLECTIVE INTELLIGENCE", "ENTRY GATES" -->
    <style name="AateSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Small tracked caption under a section title -->
    <style name="AateSectionCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Metric label under/over a number: "WIN RATE", "TRADES", "AVG WIN" -->
    <style name="AateMetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Metric value: the number itself -->
    <style name="AateMetricValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Hero readout: portfolio value, SOL balance -->
    <style name="AateHeroValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Monospace data/price/address text -->
    <style name="AateDataText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ── COMPONENTS ─────────────────────────────────────────────────── -->

    <!-- Glass panel: the standard rounded card in the reference renders -->
    <style name="AateGlassCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_metric_card_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Hero/primary panel with a stronger glow edge -->
    <style name="AateHeroCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_hero_premium_bg</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- Status pill: ONLINE / LIVE / DEGRADED -->
    <style name="AateStatusPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_glow_pill_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/aate_green</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Metric tile inside a 2/3-across grid -->
    <style name="AateMetricTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/aate_readiness_metric_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Thin neon divider -->
    <style name="AateDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/aate_stroke_soft</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Slim progress bar matching the readiness strips in the renders -->
    <style name="AateProgress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:progressDrawable">@drawable/aate_readiness_strip_bg</item>
        <item name="android:max">100</item>
    </style>

    <!--
      V5.0.7008 — AATE type scale.

      Three faces, each with one job, matching the render:
        T.Display  Space Grotesk   headings, hero labels, button text
        T.Body     IBM Plex Sans   everything that is language
        T.Mono     JetBrains Mono  everything that is a number

      Sizes are sp so they follow the operator's system text-size setting;
      nothing here is fixed in px.
    -->
    <style name="T.Display" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="T.Display.Hero">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="T.Display.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="T.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/aate_body</item>
        <item name="fontFamily">@font/aate_body</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="T.Body.Secondary">
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="T.Body.Caption">
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <style name="T.Mono" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/aate_mono</item>
        <item name="fontFamily">@font/aate_mono</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="T.Mono.Figure">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="T.Mono.Small">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
    </style>
</resources>
