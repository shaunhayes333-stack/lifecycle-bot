<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AATE vNext is intentionally dark in both system modes so every trading surface
         has one coherent visual language. This file changes presentation only. -->
    <style name="Theme.AATE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/aate_purple</item>
        <item name="colorPrimaryVariant">@color/aate_purple_bright</item>
        <item name="colorOnPrimary">@color/aate_text</item>
        <item name="colorSecondary">@color/aate_cyan</item>
        <item name="colorOnSecondary">@color/aate_bg</item>
        <item name="colorSurface">@color/aate_surface</item>
        <item name="colorOnSurface">@color/aate_text</item>
        <item name="android:colorBackground">@color/aate_bg</item>
        <item name="colorOnBackground">@color/aate_text</item>
        <item name="android:windowBackground">@drawable/aate_screen_bg</item>
        <item name="android:colorAccent">@color/aate_purple</item>
        <item name="android:textColorPrimary">@color/aate_text</item>
        <item name="android:textColorSecondary">@color/aate_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/aate_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="materialButtonStyle">@style/BtnPrimary</item>
    </style>

    <style name="Theme.AATE.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@drawable/aate_screen_bg</item>
        <item name="android:statusBarColor">@color/aate_bg_deep</item>
        <item name="android:navigationBarColor">@color/aate_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_universe_panel_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="CardLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="KpiLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="KpiValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_vnext_input_bg</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textColorHint">@color/aate_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/aate_vnext_input_bg</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="BtnPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/aate_purple</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="rippleColor">@color/aate_purple_bright</item>
    </style>

    <style name="BtnSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/aate_text</item>
        <item name="strokeColor">@color/aate_stroke</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:backgroundTint">@color/aate_surface</item>
    </style>

    <style name="Theme.AATE.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/aate_surface</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textColorPrimary">@color/aate_text</item>
        <item name="android:textColorSecondary">@color/aate_text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/aate_green</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════
         V5.0.6933 — AATE vNext type + component library.
         Derived from the operator's reference renders. Presentation only.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── TYPE SCALE ─────────────────────────────────────────────────── -->

    <!-- Screen title: "NEURAL PERSONALITY" / "TRADE JOURNAL" -->
    <style name="AateScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Sub-title under a screen title: "Instinct · Plasticity · Layer Health" -->
    <style name="AateScreenSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- Card/section heading: "COLLECTIVE INTELLIGENCE", "ENTRY GATES" -->
    <style name="AateSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Small tracked caption under a section title -->
    <style name="AateSectionCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Metric label under/over a number: "WIN RATE", "TRADES", "AVG WIN" -->
    <style name="AateMetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Metric value: the number itself -->
    <style name="AateMetricValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Hero readout: portfolio value, SOL balance -->
    <style name="AateHeroValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Monospace data/price/address text -->
    <style name="AateDataText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/aate_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ── COMPONENTS ─────────────────────────────────────────────────── -->

    <!-- Glass panel: the standard rounded card in the reference renders -->
    <style name="AateGlassCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_metric_card_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Hero/primary panel with a stronger glow edge -->
    <style name="AateHeroCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_hero_premium_bg</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- Status pill: ONLINE / LIVE / DEGRADED -->
    <style name="AateStatusPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aate_glow_pill_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/aate_green</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Metric tile inside a 2/3-across grid -->
    <style name="AateMetricTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/aate_readiness_metric_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Thin neon divider -->
    <style name="AateDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/aate_stroke_soft</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Slim progress bar matching the readiness strips in the renders -->
    <style name="AateProgress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:progressDrawable">@drawable/aate_readiness_strip_bg</item>
        <item name="android:max">100</item>
    </style>
</resources>
