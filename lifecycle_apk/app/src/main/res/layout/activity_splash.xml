<?xml version="1.0" encoding="utf-8"?>
<!--
  V5.0.6995 — splash rebuilt against the operator's render, artifacts removed.

  THE ARTIFACTS. The 6931 version stacked FOUR competing visual layers on the
  same centre point:

      layoutParticles      40 code-created Views animating edge -> centre
      viewGlow             360dp bloom
      AnimatedBrainLogoView 340dp pulsing rings
      ivSplashLogo         252dp logo

  A 340dp ring set and a 360dp bloom behind a 252dp mark means the rings and
  the bloom both extend well past the logo in every direction, with particles
  crossing through all of it. That is what reads as "weird with remaining
  artifacts" — nothing is contained, so nothing has an edge.

  The render solves it by CONTAINING the mark: one bounded glow card holding
  the logo and the wordmark, everything else behind and smaller than the card.

  WHAT CHANGED
    - the lockup now sits in a bounded @drawable/aate_glow_card_bg card
    - viewGlow 360dp -> 300dp so the bloom stays behind the card rather than
      haloing past it
    - AnimatedBrainLogoView 340dp -> 288dp, likewise contained
    - ivSplashLogo 252dp -> 168dp so the mark sits INSIDE its card with margin
      instead of filling and overflowing it
    - the wordmark now reads AATe(R) over ADAPTIVE INTELLIGENCE, matching the
      brand card in the render rather than a bare subtitle

  EVERY ID SplashActivity TOUCHES IS PRESERVED: ivSplashLogo, layoutParticles,
  tvSplashTagline, tvSplashVersion, viewGlow, animatedBrainLogo,
  tvSplashTrademark, tvSplashCopyright. findViewById on a removed id would
  crash the first screen the operator sees, so none were removed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aate_screen_bg"
    android:fitsSystemWindows="false">

    <!-- Neural pathway particles (animated in code) — behind everything -->
    <FrameLayout
        android:id="@+id/layoutParticles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Glow bloom, now smaller than the card so it reads as backlight -->
    <View
        android:id="@+id/viewGlow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_glow"
        android:alpha="0.30"/>

    <!-- Pulsing brain-wave rings, contained behind the card -->
    <com.lifecyclebot.ui.AnimatedBrainLogoView
        android:id="@+id/animatedBrainLogo"
        android:layout_width="288dp"
        android:layout_height="288dp"
        android:layout_gravity="center"/>

    <!-- Centred brand lockup, CONTAINED in a glow card as the render shows -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/aate_glow_card_bg"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="26dp"
        android:paddingBottom="22dp"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="AATE Logo"/>

        <!-- Wordmark — matches the brand card in the render -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="AATe®"
            android:textColor="@color/aate_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ADAPTIVE INTELLIGENCE"
            android:textColor="@color/aate_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.30"/>

        <!-- Hairline rule under the wordmark -->
        <View
            android:layout_width="150dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/aate_stroke"/>

        <!-- Boot tagline — animated in from invisible by SplashActivity -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="AUTONOMOUS ALGORITHMIC TRADING ENGINE"
            android:textColor="@color/aate_purple_bright"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:visibility="invisible"/>

        <!-- Doctrine strip, as the render's brand card carries it -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="TRADE  ·  EVOLVE  ·  REPEAT"
            android:textColor="@color/aate_text_muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.22"/>

    </LinearLayout>

    <!-- Version — boot build string, shown after neural init -->
    <TextView
        android:id="@+id/tvSplashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="84dp"
        android:background="@drawable/aate_glow_pill_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text=""
        android:textColor="@color/aate_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:visibility="invisible"/>

    <!--
      V5.0.7031 — the render's boot bar and stage line.

      project/Splash.dc.html carries a 188px gradient progress rail with a
      stage caption under it: "canonical ledger …", "fill-lot registry …",
      "council probe …", "scanner queue …", "ready". The shipped splash showed
      a logo, a wordmark and nothing about what the app was doing, so a slow
      boot and a hung boot looked identical for four seconds.

      This is not a timer pretending to be progress. SplashActivity drives it
      from the bootstrap phases that already exist and already emit
      (SERVICE_BOOTSTRAP_PHASE_6516 / CANONICAL_BOOTSTRAP_READY_6515), so the
      line names the stage the app is genuinely in — which is the only version
      of this worth building, and the difference between a progress bar and a
      decoration that happens to move.
    -->
    <LinearLayout
        android:layout_width="188dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="128dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/splashBootTrack"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/aate_boot_track"/>

        <TextView
            android:id="@+id/tvSplashStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#6E82A8"
            android:textSize="10sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Legal — low contrast, stays out of the way -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvSplashTrademark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AATE® is a registered trademark"
            android:textColor="@color/aate_text_muted"
            android:alpha="0.55"
            android:textSize="9sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tvSplashCopyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="© 2024-2026 Lifecycle Technologies. All rights reserved."
            android:textColor="@color/aate_text_muted"
            android:alpha="0.45"
            android:textSize="8sp"
            android:fontFamily="monospace"/>

    </LinearLayout>

</FrameLayout>
