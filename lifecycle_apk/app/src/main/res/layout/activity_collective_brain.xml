<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/aate_screen_bg"
    android:fitsSystemWindows="true">

    <!-- ── TOP BAR ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:background="@drawable/aate_screen_bg">

        <TextView
            android:id="@+id/btnBrainBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/aate_text"
            android:textSize="22sp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/AateScreenTitle"
                android:text="HIVE MIND"/>

            <TextView
                style="@style/AateScreenSubtitle"
                android:text="More Minds · Better Edges"/>
        </LinearLayout>

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking…"
                android:textColor="@color/aate_text_muted"
                android:textSize="9sp"
                android:fontFamily="monospace"/>

        </LinearLayout>

        <!-- Data source badge -->
        <TextView
            android:id="@+id/tvBrainDataSource"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="LOCAL"
            android:textColor="@color/aate_purple"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/aate_glow_pill_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
        android:letterSpacing="0.12" />

        <!-- Sync now -->
        <TextView
            android:id="@+id/btnForceSync"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="↻ Sync"
            android:textColor="@color/aate_bg_deep"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/pill_bg_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Purple accent divider — this is the hive's pulse line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2D1B69"/>

    <!-- ── SCROLLABLE CONTENT ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="@dimen/card_margin"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!--
                 V5.0.7014 §THE_HIVE_HAD_NINE_EQUAL_TILES_AND_NO_SUBJECT.

                 The screen carried three identical three-up rows: nine figures
                 at one weight (22sp mono over an 8sp caption), with nothing
                 saying which of the nine the operator opened the screen to
                 read. The render answers that first — one subject, stated
                 large, with its supporting figures demoted around it — and then
                 separates groups with a tracked rule rather than a 3dp bar.

                 It also carried a real alignment bug: the parent already pads
                 by screen_padding, and the first and last tile of each row
                 ALSO set layout_marginStart/End="@dimen/screen_padding". So
                 every row was inset twice on its outer edges and once in the
                 middle, which is why the tiles never lined up with anything
                 above or below them. Gone — one gutter, from the parent.

                 Every id is preserved. Nothing here reads a new source.
            -->

            <!-- ── HERO: the hive itself, and the one number it is about ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/aate_hero_premium_bg"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="14dp" android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <com.lifecyclebot.ui.AnimatedBrainView
                        android:id="@+id/brainView"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="150dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="12dp">

                        <!-- Bound in CollectiveBrainActivity to displayWrFinal —
                             the same figure the WIN RATE tile below prints. -->
                        <com.lifecyclebot.ui.RingGaugeView7010
                            android:id="@+id/hiveHealthRing"
                            android:layout_width="78dp"
                            android:layout_height="78dp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TRADES LEARNED FROM" style="@style/T.Body.Caption"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvBrainTotalTrades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/aate_text"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_mono"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="20sp"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeStepGranularity="1sp"/>

                <TextView
                    android:id="@+id/tvBrainTotalProfit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/aate_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/aate_mono"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/btnBoost"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="SIGNAL BOOST — SCAN &amp; BACKTEST"
                    android:textColor="@color/aate_bg_deep"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.10"
                    android:background="@drawable/pill_bg_yellow"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NETWORK"
                    android:textColor="@color/aate_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.20"/>
                <View
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@color/aate_stroke_soft"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/aate_metric_card_bg"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginStart="0dp" android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="NODES" style="@style/T.Body.Caption"/>
                    <TextView
                        android:id="@+id/tvBrainActiveInstances"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/aate_purple"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/aate_mono"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/aate_metric_card_bg"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginStart="5dp" android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PATTERNS" style="@style/T.Body.Caption"/>
                    <TextView
                        android:id="@+id/tvBrainPatternsLearned"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/aate_green"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/aate_mono"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/aate_metric_card_bg"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginStart="5dp" android:layout_marginEnd="0dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BLOCKED" style="@style/T.Body.Caption"/>
                    <TextView
                        android:id="@+id/tvBrainBlacklistedTokens"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/aate_red"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/aate_mono"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PERFORMANCE"
                    android:textColor="@color/aate_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.20"/>
                <View
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@color/aate_stroke_soft"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/aate_metric_card_bg"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginStart="0dp" android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="WIN RATE" style="@style/T.Body.Caption"/>
                    <TextView
                        android:id="@+id/tvBrainWinRate"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/aate_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/aate_mono"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/aate_metric_card_bg"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginStart="5dp" android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AVG HOLD" style="@style/T.Body.Caption"/>
                    <TextView
                        android:id="@+id/tvBrainAvgHold"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/aate_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/aate_mono"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/aate_metric_card_bg"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginStart="5dp" android:layout_marginEnd="0dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="W / L" style="@style/T.Body.Caption"/>
                    <TextView
                        android:id="@+id/tvBrainTotalLoss"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/aate_text_secondary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/aate_mono"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LANES"
                    android:textColor="@color/aate_amber"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.20"/>
                <View
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@color/aate_stroke_soft"/>
                <TextView
                    android:id="@+id/tvBrainTopMode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/aate_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_mono"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llBrainModeStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/aate_metric_card_bg"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="12dp" android:paddingBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AVOID"
                    android:textColor="@color/aate_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.20"/>
                <View
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@color/aate_stroke_soft"/>
                <TextView
                    android:id="@+id/tvBrainWorstMode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/aate_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_mono"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TOP PATTERNS"
                    android:textColor="@color/aate_purple"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.20"/>
                <View
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@color/aate_stroke_soft"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llBrainPatterns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/aate_metric_card_bg"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="6dp" android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvNoBrainData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Learning from live trades…"
                    android:textColor="@color/aate_text_muted"
                    android:textSize="11.5sp"
                    android:gravity="center"
                    android:padding="20dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NETWORK SIGNALS"
                    android:textColor="@color/aate_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/aate_body"
                    android:letterSpacing="0.20"/>
                <View
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@color/aate_stroke_soft"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llBrainSignals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/aate_metric_card_bg"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="6dp" android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Awaiting signals from the hive…"
                    android:textColor="@color/aate_text_muted"
                    android:textSize="11.5sp"
                    android:gravity="center"
                    android:padding="20dp"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
