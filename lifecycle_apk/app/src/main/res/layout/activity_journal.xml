<?xml version="1.0" encoding="utf-8"?>
<!--
  V5.0.6937 — Trade Journal reformatted to the reference design.

  This is a STRUCTURAL change, not a recolour. What moved:

    header      16sp sentence-case "Trade Journal", no subtitle
                -> 19sp bold TRACKED CAPS + "Track · Analyze · Improve"
                   subtitle, on a taller bar
    summary     edge-to-edge flat strip, 9sp labels, 15sp values
                -> inset rounded glass card, 16dp margins, tracked caps
                   labels and 22sp values that read as the hero data
    divider     a 1dp line made from a card background drawable
                -> removed; the card's own edge does that job
    list        8dp top padding against a flat background
                -> 12dp gutters so rows sit in the same column as the card

  THE ID CONTRACT IS UNCHANGED. JournalActivity binds exactly nine ids —
  btnJournalBack, btnRestoreStats, btnExportCsv, btnClearJournal,
  tvJournalPnl, tvJournalWinRate, tvJournalCount, tvJournalAvgWin,
  llJournalTrades — and all nine are present below with compatible types
  (the four buttons are read as findViewById<View>, so TextView is fine).
  Nothing was added that has no code behind it: the reference shows
  ALL/LIVE/PAPER filter pills, but JournalActivity has no filter logic, and
  shipping dead controls would be worse than leaving them out.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aate_screen_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnJournalBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/aate_text"
            android:textSize="24sp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/AateScreenTitle"
                android:text="Trade Journal"/>

            <TextView
                style="@style/AateScreenSubtitle"
                android:text="Track · Analyze · Improve"/>
        </LinearLayout>

        <TextView android:id="@+id/btnRestoreStats"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Restore" android:textColor="@color/aate_green"
            android:textSize="11sp" android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:paddingStart="6dp" android:paddingEnd="10dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:clickable="true" android:focusable="true"/>

        <TextView android:id="@+id/btnExportCsv"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Export" android:textColor="@color/aate_purple_bright"
            android:textSize="11sp" android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:paddingStart="6dp" android:paddingEnd="10dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:clickable="true" android:focusable="true"/>

        <TextView android:id="@+id/btnClearJournal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Clear" android:textColor="@color/aate_red"
            android:textSize="11sp" android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:paddingStart="6dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- ══ SUMMARY CARD ════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/aate_universe_panel_bg"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/AateMetricLabel" android:text="TOTAL P&amp;L"/>
            <TextView android:id="@+id/tvJournalPnl"
                style="@style/AateMetricValue"
                android:layout_marginTop="6dp"
                android:textSize="22sp"
                android:textColor="@color/aate_green"
                android:text="—"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/AateMetricLabel" android:text="WIN RATE"/>
            <TextView android:id="@+id/tvJournalWinRate"
                style="@style/AateMetricValue"
                android:layout_marginTop="6dp"
                android:textSize="22sp"
                android:text="—"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/AateMetricLabel" android:text="TRADES"/>
            <TextView android:id="@+id/tvJournalCount"
                style="@style/AateMetricValue"
                android:layout_marginTop="6dp"
                android:textSize="22sp"
                android:text="0"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/AateMetricLabel" android:text="AVG WIN"/>
            <TextView android:id="@+id/tvJournalAvgWin"
                style="@style/AateMetricValue"
                android:layout_marginTop="6dp"
                android:textSize="22sp"
                android:textColor="@color/aate_green"
                android:text="—"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ══ EQUITY CURVE (V5.0.7021) ════════════════════════════════════
         The graph a trade journal most obviously wants and this one never
         had. Four stat tiles above answered "how much" and "how often"; none
         of them answered "which way, and when did it turn" — which is the
         question you open a journal to ask. Cumulative realised P&L over the
         closed trades the journal is already listing below, so the curve and
         the rows can never disagree about the same session.
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/aate_metric_card_bg"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="14dp"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EQUITY CURVE" style="@style/T.Body.Caption"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:background="@color/aate_stroke_soft"/>
            <TextView android:id="@+id/tvJournalCurveNote"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" style="@style/T.Mono.Small"/>
        </LinearLayout>

        <com.lifecyclebot.ui.SparklineView7009
            android:id="@+id/journalEquityCurve"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- ══ TRADE LIST ══════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout android:id="@+id/llJournalTrades"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="36dp"/>
    </ScrollView>
</LinearLayout>
