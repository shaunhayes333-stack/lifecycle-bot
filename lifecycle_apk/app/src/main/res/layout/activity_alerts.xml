<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aate_screen_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ── TOP BAR ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:background="@drawable/aate_screen_bg">

        <!--
          V5.0.7031 — the render's bordered back tile, on the last two screens
          still carrying a bare arrow glyph. It is the one control on every
          artboard, so it was the most visible remaining mismatch.
        -->
        <TextView
            android:id="@+id/btnAlertsBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/aate_text_secondary"
            android:textSize="16sp"
            android:background="@drawable/aate_back_tile"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                style="@style/AateScreenTitle"
                android:text="Alert History"/>

            <TextView
                style="@style/AateScreenSubtitle"
                android:text="Signals · History · Triage"/>
        </LinearLayout>

        <TextView android:id="@+id/btnClearAlerts"
            android:layout_width="wrap_content" android:layout_height="26dp"
            android:gravity="center"
            android:text="Clear" android:textColor="#FCA5A5" android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/aate_action_danger"
            android:paddingStart="11dp" android:paddingEnd="11dp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/llAlerts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"/>
    </ScrollView>
</LinearLayout>
